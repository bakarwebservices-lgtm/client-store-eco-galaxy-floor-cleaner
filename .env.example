# =============================================================================
# AWWeb Merged SaaS Template — Environment Configuration Template
# All secret keys and client-specific environment variables.
# Reference: BUILD_STANDARDS.md section 1.11
# =============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce_db?schema=public"

# Node Environment
NODE_ENV="development"

# App Public URL (Canonical origin)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Secrets (Must be min 32 chars in production)
ADMIN_JWT_SECRET="replace-with-a-secure-random-32-character-secret-for-admin"
CUSTOMER_JWT_SECRET="replace-with-a-secure-random-32-character-secret-for-customer"

# Master Encryption Key (32 bytes = 64 hex characters for AES-256-GCM)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Initial Admin User (Used by prisma/seed.ts for first admin account)
INITIAL_ADMIN_NAME="Store Administrator"
INITIAL_ADMIN_EMAIL="admin@store.com"
INITIAL_ADMIN_PASSWORD="admin_password_123!"

# Pluggable Media Storage (Supabase Storage / Cloudinary / Local)
STORAGE_DRIVER="cloudinary" # 'cloudinary' | 'supabase' | 'local'

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""

# Supabase Storage & API
SUPABASE_URL="https://<your-project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_STORAGE_BUCKET="Media-Bucket"
SUPABASE_SERVICE_ROLE_KEY=""

# Couriers (Optional / Pakistan multi-courier)
POSTEX_API_TOKEN=""

# Payment Gateways (Optional / per client setup)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox" # sandbox | live

# Tracking & Analytics (Optional / per client setup)
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""

# Transactional SMTP Email (Optional / per client setup)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@store.com"
